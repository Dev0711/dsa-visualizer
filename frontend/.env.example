# ============================================================
# DSA Visualizer — Frontend Environment Variables
#
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real values.
# ============================================================

# -------------------------------------------------------------
# VITE_API_BASE_URL
#
# The base URL of your deployed Spring Boot backend.
# Do NOT include a trailing slash. Do NOT include /api — that
# is appended automatically by src/api/visualize.js.
#
# Examples:
#   https://dsa-visualizer-backend.onrender.com
#   http://localhost:8080   (same as dev default, explicit)
#
# In development:
#   Leave this UNSET. Vite's dev server proxy (vite.config.js)
#   forwards /api requests to http://localhost:8080 automatically.
#
# In production (Vercel):
#   Set this in: Vercel Dashboard → Project → Settings → Environment Variables
#   Key:   VITE_API_BASE_URL
#   Value: https://your-backend-name.onrender.com
# -------------------------------------------------------------
# VITE_API_BASE_URL=https://your-dsa-visualizer-backend.onrender.com
